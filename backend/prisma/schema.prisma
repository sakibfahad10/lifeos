generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CalendarItemType {
  TASK
  EVENT
  REMINDER
}

enum CalendarItemStatus {
  PENDING
  COMPLETED
  CANCELLED
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum NotificationType {
  REMINDER
  OVERDUE
  MISSED
  SYSTEM
  AI_IMPORT
}

enum AiImportStatus {
  PROCESSING
  REVIEW
  CONFIRMED
  REJECTED
  FAILED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  calendarItems   CalendarItem[]
  notifications   Notification[]
  reminders       Reminder[]
  aiImportDrafts  AiImportDraft[]
  attachments     Attachment[]
  auditLogs       AuditLog[]

  @@index([email])
}

model CalendarItem {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  title           String
  description     String?
  type            CalendarItemType
  status          CalendarItemStatus @default(PENDING)
  priority        Priority          @default(MEDIUM)
  category        String?
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean          @default(false)
  location        String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceRule  RecurrenceRule?
  notifications   Notification[]
  reminders       Reminder[]
  attachments     Attachment[]

  @@index([userId])
  @@index([startAt])
  @@index([status])
  @@index([category])
}

model RecurrenceRule {
  id            String              @id @default(uuid()) @db.Uuid
  calendarItemId String             @unique @db.Uuid
  frequency     RecurrenceFrequency
  interval      Int                 @default(1)
  daysOfWeek    Int[]
  dayOfMonth    Int?
  startDate     DateTime
  endDate       DateTime?
  timezone      String              @default("UTC")
  calendarItem  CalendarItem        @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)
}

model Reminder {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  calendarItemId String       @db.Uuid
  offsetMinutes  Int
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarItem   CalendarItem @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([calendarItemId])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  calendarItemId String?          @db.Uuid
  type           NotificationType
  title          String
  message        String
  scheduledAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarItem   CalendarItem?    @relation(fields: [calendarItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduledAt])
  @@index([readAt])
}

model AiImportDraft {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  sourceType       String
  originalFileName String?
  status           AiImportStatus   @default(PROCESSING)
  rawResponse      Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            AiImportItem[]

  @@index([userId])
  @@index([status])
}

model AiImportItem {
  id              String           @id @default(uuid()) @db.Uuid
  draftId         String           @db.Uuid
  title           String
  description     String?
  startAt         DateTime?
  endAt           DateTime?
  type            CalendarItemType @default(EVENT)
  category        String?
  priority        Priority         @default(MEDIUM)
  recurrence      Json?
  confidenceScore Decimal?         @db.Decimal(5, 4)
  selected        Boolean          @default(true)
  edited          Boolean          @default(false)
  draft           AiImportDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model Attachment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  calendarItemId String?       @db.Uuid
  fileName       String
  fileType       String
  fileSize       Int
  storageKey     String        @unique
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarItem   CalendarItem? @relation(fields: [calendarItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([calendarItemId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Create a migration with: pnpm --dir backend db:migrate
// Then generate the client with: pnpm --dir backend db:generate
