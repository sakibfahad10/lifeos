generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CalendarItemType {
  TASK
  EVENT
  REMINDER
}

enum CalendarItemStatus {
  PENDING
  COMPLETED
  CANCELLED
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum NotificationType {
  REMINDER
  OVERDUE
  MISSED
  SYSTEM
  AI_IMPORT
}

enum AlertSeverity {
  NORMAL
  IMPORTANT
  CRITICAL
}

enum AlertTriggerType {
  OFFSET_BEFORE
  EXACT_TIME
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED_QUIET_HOURS
  SNOOZED
  DISMISSED
}

enum AiImportStatus {
  PROCESSING
  REVIEW
  CONFIRMED
  REJECTED
  FAILED
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  email           String           @unique
  passwordHash    String?
  settings        Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  calendarItems   CalendarItem[]
  notifications   Notification[]
  reminders       Reminder[]
  alerts          Alert[]
  aiImportDrafts  AiImportDraft[]
  attachments     Attachment[]
  auditLogs       AuditLog[]

}

model CalendarItem {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  title           String
  description     String?
  type            CalendarItemType
  status          CalendarItemStatus @default(PENDING)
  priority        Priority          @default(MEDIUM)
  category        String?
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean          @default(false)
  estimatedMinutes Int?
  location        String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurrenceRule  RecurrenceRule?
  notifications   Notification[]
  reminders       Reminder[]
  alerts          Alert[]
  attachments     Attachment[]

  @@index([userId])
  @@index([startAt])
  @@index([status])
  @@index([category])
}

model RecurrenceRule {
  id            String              @id @default(uuid()) @db.Uuid
  calendarItemId String             @unique @db.Uuid
  frequency     RecurrenceFrequency
  interval      Int                 @default(1)
  daysOfWeek    Int[]
  dayOfMonth    Int?
  startDate     DateTime
  endDate       DateTime?
  timezone      String              @default("UTC")
  calendarItem  CalendarItem        @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)
}

model Reminder {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  calendarItemId String       @db.Uuid
  offsetMinutes  Int
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarItem   CalendarItem @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([calendarItemId])
}

model Alert {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  calendarItemId   String?          @db.Uuid
  title            String?
  triggerType      AlertTriggerType @default(OFFSET_BEFORE)
  offsetMinutes    Int?             @default(15)
  exactTime        DateTime?
  channels         String[]         @default(["IN_APP", "BROWSER"])
  severity         AlertSeverity    @default(NORMAL)
  soundName        String?          @default("REMINDER")
  soundVolume      Int              @default(80)
  soundRepeat      Int              @default(1)
  enabled          Boolean          @default(true)
  order            Int              @default(0)
  escalationStep   Int?
  lastTriggeredAt  DateTime?
  snoozedUntil     DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarItem     CalendarItem?    @relation(fields: [calendarItemId], references: [id], onDelete: Cascade)
  deliveries       AlertDelivery[]
  notifications    Notification[]

  @@index([userId])
  @@index([calendarItemId])
  @@index([enabled])
}

model AlertDelivery {
  id           String         @id @default(uuid()) @db.Uuid
  alertId      String         @db.Uuid
  userId       String         @db.Uuid
  channel      String
  status       DeliveryStatus @default(PENDING)
  scheduledFor DateTime
  sentAt       DateTime?
  error        String?
  retryCount   Int            @default(0)
  payload      Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  alert        Alert          @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  calendarItemId String?          @db.Uuid
  type           NotificationType
  severity       AlertSeverity    @default(NORMAL)
  title          String
  message        String
  channels       String[]         @default(["IN_APP"])
  soundName      String?
  soundVolume    Int?             @default(80)
  soundRepeat    Int?             @default(1)
  snoozedUntil   DateTime?
  status         DeliveryStatus   @default(SENT)
  alertId        String?          @db.Uuid
  metadata       Json?
  scheduledAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarItem   CalendarItem?    @relation(fields: [calendarItemId], references: [id], onDelete: SetNull)
  alert          Alert?           @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([scheduledAt])
  @@index([readAt])
  @@index([status])
  @@index([severity])
}

model AiImportDraft {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  sourceType       String
  originalFileName String?
  status           AiImportStatus   @default(PROCESSING)
  rawResponse      Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            AiImportItem[]

  @@index([userId])
  @@index([status])
}

model AiImportItem {
  id              String           @id @default(uuid()) @db.Uuid
  draftId         String           @db.Uuid
  title           String
  description     String?
  startAt         DateTime?
  endAt           DateTime?
  type            CalendarItemType @default(EVENT)
  category        String?
  priority        Priority         @default(MEDIUM)
  recurrence      Json?
  reminderMinutes Int?
  confidenceScore Decimal?         @db.Decimal(5, 4)
  selected        Boolean          @default(true)
  edited          Boolean          @default(false)
  draft           AiImportDraft   @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model Attachment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  calendarItemId String?       @db.Uuid
  fileName       String
  fileType       String
  fileSize       Int
  storageKey     String        @unique
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarItem   CalendarItem? @relation(fields: [calendarItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([calendarItemId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// Add settings JSON with: pnpm --dir backend db:migrate
// Then generate the client with: pnpm --dir backend db:generate
