# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lifeos?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/lifeos?schema=public

# Supabase Auth (Get from https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Frontend & Backend URLs
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1
PORT=4000
NODE_ENV=development

# Optional AI Features
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
