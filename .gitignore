# Dependencies
node_modules/
.pnpm-store/

# Build output
.next/
out/
dist/
*.tsbuildinfo

# Environment
# Real .env files must never be committed. Copy .env.example to .env and
# fill in your own credentials. Note: the keys that were previously
# committed here before this rule existed are still in git history and on
# the remote — they need to be rotated, not just ignored.
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
